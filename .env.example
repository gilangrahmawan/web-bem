APP_NAME="BEM UBHINUS"
APP_ENV=local
APP_KEY=
# Produksi: APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bem_ubhinus
DB_USERNAME=root
DB_PASSWORD=

# Session 30 menit (AGENTS.md B4). Produksi (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Disk S3-compatible (nanti untuk Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Akun Super Admin pertama (Ketua), dipakai SuperAdminSeeder ---
# Ganti semua nilai GANTI_... sebelum menjalankan seeder. Seeder menolak berjalan
# selama nilainya masih placeholder. Password min. 10 karakter: huruf, angka, simbol.
# Setelah login pertama Anda wajib mengganti password; sesudah itu hapus
# SUPERADMIN_PASSWORD dari .env.
SUPERADMIN_NAME="GANTI_NAMA_KETUA"
SUPERADMIN_EMAIL="GANTI_EMAIL@contoh.test"
SUPERADMIN_PASSWORD="GANTI_PASSWORD"

# --- Akun uji (DemoSeeder) ---
# PERINGATAN: DEMO_PASSWORD dan DemoSeeder HANYA UNTUK LOKAL.
# JANGAN dipakai di produksi. DemoSeeder hanya berjalan saat APP_ENV=local;
# di produksi biarkan DEMO_PASSWORD kosong.
DEMO_PASSWORD=

APP_NAME="BEM UBHINUS"
APP_ENV=local
APP_KEY=
# Produksi: APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bem_ubhinus
DB_USERNAME=root
DB_PASSWORD=

# Session 30 menit (AGENTS.md B4). Produksi (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi (HTTPS): true. Kosongkan baris ini agar otomatis mengikuti APP_URL.
SESSION_SECURE_COOKIE=false

# Chat real-time: "pusher" bila PUSHER_* diisi; "log" = tanpa real-time (chat memakai polling 5 detik).
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Disk S3-compatible (nanti untuk Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Akun Super Admin pertama (Ketua) ---
# PRODUKSI: kosongkan ketiganya (SUPERADMIN_NAME= dst.) lalu buat akun dengan
#   php artisan bem:create-admin   (password diketik tersembunyi, tidak disimpan di .env).
# LOKAL: boleh diisi untuk SuperAdminSeeder.
# Ganti semua nilai GANTI_... sebelum menjalankan seeder. Seeder menolak berjalan
# selama nilainya masih placeholder. Password min. 10 karakter: huruf, angka, simbol.
# Setelah login pertama Anda wajib mengganti password; sesudah itu hapus
# SUPERADMIN_PASSWORD dari .env.
SUPERADMIN_NAME="GANTI_NAMA_KETUA"
SUPERADMIN_EMAIL="GANTI_EMAIL@contoh.test"
SUPERADMIN_PASSWORD="GANTI_PASSWORD"

# --- Akun uji (DemoSeeder) ---
# PERINGATAN: DEMO_PASSWORD dan DemoSeeder HANYA UNTUK LOKAL.
# JANGAN dipakai di produksi. DemoSeeder hanya berjalan saat APP_ENV=local;
# di produksi biarkan DEMO_PASSWORD kosong.
DEMO_PASSWORD=

# Cloudflare Turnstile (CAPTCHA form publik). Isi kunci asli saat deploy.
# Kunci uji lokal Cloudflare: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Pusher Channels (chat real-time, Fase 9). Paket Sandbox gratis, cluster ap1 (Singapura).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# Web Push (PWA). Buat dengan: php artisan webpush:vapid
# (Windows lokal: set OPENSSL_CONF dulu, lihat docs/CATATAN-PRODUKSI.md). Jangan di-commit.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# HSTS: nyalakan HANYA setelah HTTPS berjalan normal beberapa hari (lihat docs/DEPLOY.md).
HSTS_ENABLED=false

# Backup (Fase 10). WAJIB disimpan aman bersama APP_KEY — tanpa ini ZIP backup tidak bisa dibuka.
BACKUP_ARCHIVE_PASSWORD=
# backups = folder storage/backups di server; r2 = Cloudflare R2 (isi R2_* di bawah).
BACKUP_DISK=backups
# Folder mysqldump bila tidak ada di PATH (XAMPP: C:/xampp/mysql/bin). Kosong di hosting Linux.
DB_DUMP_BINARY_PATH=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Hosting dengan document root public_html yang tidak bisa diubah (lihat docs/DEPLOY.md bagian 3B).
# Contoh: PUBLIC_PATH=/home/akun/public_html  — kosongkan bila domain diarahkan ke folder public/.
PUBLIC_PATH=
